# ==============================================================================
# TV Today NPL Cricket Management System — Environment Configuration
# Production Domain: https://cricket.tvtoday.com.np
# ==============================================================================

# Database Connection (MySQL)
# When running inside Docker on almari-network with almari-mysql:
DATABASE_URL="mysql://admin:quantumSql%40123@almari-mysql:3306/cricket_db"
# When running locally outside Docker against the exposed port 3307:
# DATABASE_URL="mysql://admin:quantumSql%40123@localhost:3307/cricket_db"

# Server Ports
PORT=3000
WS_PORT=3001
NODE_ENV=production

# Public Brand & URLs
NEXT_PUBLIC_APP_NAME="TV Today NPL Cricket Management"
NEXT_PUBLIC_SITE_URL="https://cricket.tvtoday.com.np"
NEXT_PUBLIC_WS_URL="wss://cricket.tvtoday.com.np/ws"

# Seeding Behavior
# Seed all teams, franchises, squad rosters, and official 32 fixtures schedule
SEED_DATABASE="true"
# Strictly false in production: no fake scores, matches start clean SCHEDULED for live sync
SEED_MATCH_SCORES="false"

# File Upload Limits
UPLOAD_MAX_MB="25"
