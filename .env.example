# ==============================================================================
# TV Today NPL Cricket Management System — Environment Configuration Template
# Production Domain: https://cricket.tvtoday.com.np
# ==============================================================================

# Database Connection (MySQL)
DATABASE_URL="mysql://admin:quantumSql%40123@almari-mysql:3306/cricket_db"

# Server Ports
PORT=3211
WS_PORT=3212
NODE_ENV=production

# Public Brand & URLs
NEXT_PUBLIC_APP_NAME="TV Today NPL Cricket Management"
NEXT_PUBLIC_SITE_URL="https://cricket.tvtoday.com.np"
NEXT_PUBLIC_WS_URL="wss://cricket.tvtoday.com.np/ws"

# Seeding Configuration
SEED_DATABASE="true"
SEED_MATCH_SCORES="false"
# Optional one-time match data wipe on boot (keeps teams/players/franchises). Runs once per token value.
RESET_MATCH_DATA_TOKEN=""

# File Upload Limits
UPLOAD_MAX_MB="25"
